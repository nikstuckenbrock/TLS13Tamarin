rule extended_key_udpate_finish_server[color=#EA3788]:
    let
        p_g = $g
        finish = Handshake(HandshakeMessageTypeExtendedKeyUpdate(), ExtendedKeyUpdateFinish())
        gxy = ~k
        transcript_hash_n_1 = h(<request, response>)
        
        derived_secret = Expand(p_ms, <'32', 'TLS13derived', '0'>, '32')
        main_secret_n_1 = Extract(gxy, derived_secret)
        client_application_traffic_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13clientapplicationtrafficsecret', transcript_hash_n_1>, '32')
        server_application_traffice_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13serverapplicationtrafficsecret', transcript_hash_n_1>, '32')
        exporter_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13exportermastersecret', transcript_hash_n_1>, '32')
        resumption_main_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13resumptionmastersecret', transcript_hash_n_1>, '32')

        client_application_traffic_key = Expand(client_application_traffic_secret_n_1, <'32', 'TLS13applicationdatakeyexpansion_key', '0'>, '32')
        server_application_traffic_key = Expand(server_application_traffice_secret_n_1, <'32', 'TLS13applicationdatakeyexpansion_key', '0'>, '32')

        auth_status = <'0', '0'>
    in
    [
        Fr(~newSendStreamId),
        Fr(~newRecvStreamId),
        !KeyValues(~k),
        S4_Extended_Key_Update(~tid, ~ekuIdOld, 'EKU1', $S, $C, ~x, gy, <request, response>),
        SendStream(~tid, ~sendStreamId, $S, $C, p_auth_status, applicationTrafficKeyServer),
        RecvStream(~tid, ~recvStreamId, $S, $C, p_auth_status, p_app_keyc),
        ServerState(
            ~tid,
            'S4',
            $S,
            $C,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            p_es,
            p_hs,
            p_ms,
            p_cats,
            p_sats,
            p_hs_keyc,
            p_hs_keys,
            p_auth_status,
            p_ems,
            p_rms,
            p_cert_req,
            ExtendedKeyUpdateRunning(),
            ~ekuIdOld,
            PostHandshakeAuthenticationNotRunning()
        )[no_precomp]
    ]
    --[
        ExtendedKeyUpdateFinishServer(~tid, $S),
        ExtendedKeyUpdateFinishServerDetails(~tid, ~ekuIdOld, 'EKU1', $S, $C, ~x, gy, '0', <request, response>),
        Decaps(~k, gy, kem_pk(~x), ~x),
        Instance(~tid, $S, 'server'),
        SessionKey(~tid, $S, $C, auth_status, <server_application_traffic_key, client_application_traffic_key>),
        EKUWriteKeyDerivation(~tid, $S, $C, server_application_traffic_key, kem_pk(~x), ~k),
        EKUReadKeyDerivation(~tid, $S, $C, client_application_traffic_key, kem_pk(~x), ~k),
        EKUMainSecret(~tid, $S, kem_pk(~x), p_ms, main_secret_n_1)
    ]->
    [
        SendStream(~tid, ~newSendStreamId, $S, $C, auth_status, server_application_traffic_key),
        RecvStream(~tid, ~newRecvStreamId, $S, $C, auth_status, client_application_traffic_key),
        MessageOut(senc{finish}applicationTrafficKeyServer),
        ServerState(
            ~tid,
            'S4',
            $S,
            $C,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            exporter_secret_n_1,
            p_hs,
            main_secret_n_1,
            client_application_traffic_secret_n_1,
            server_application_traffice_secret_n_1,
            p_hs_keyc,
            p_hs_keys,
            auth_status,
            p_ems,
            resumption_main_secret_n_1,
            p_cert_req,
            ExtendedKeyUpdateNotRunning(),
            ExtendedKeyUpdateNotRunning(),
            PostHandshakeAuthenticationNotRunning()
        )[no_precomp]
    ]

