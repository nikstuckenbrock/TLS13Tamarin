    ]

rule extended_key_update_response_client[color=#340068]:
    let
        p_g = $negotiated_group
        key_share_entry = KeyShareEntry(p_g, ~ct)
        response = Handshake(HandshakeMessageTypeExtendedKeyUpdate(), ExtendedKeyUpdateResponse(key_share_entry))
        
        transcript_hash_n_1 = h(<request, response>)
        
        derived_secret = Expand(p_ms, <'32', 'TLS13derived', '0'>, '32')
        main_secret_n_1 = Extract(~k, derived_secret)
        client_application_traffic_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13clientapplicationtrafficsecret', transcript_hash_n_1>, '32')
        server_application_traffice_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13serverapplicationtrafficsecret', transcript_hash_n_1>, '32')
        exporter_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13exportermastersecret', transcript_hash_n_1>, '32')
        resumption_main_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13resumptionmastersecret', transcript_hash_n_1>, '32')

        client_application_traffic_key = Expand(client_application_traffic_secret_n_1, <'32', 'TLS13applicationdatakeyexpansion_key', '0'>, '32')
        server_application_traffic_key = Expand(server_application_traffice_secret_n_1, <'32', 'TLS13applicationdatakeyexpansion_key', '0'>, '32')

        auth_status = <'0', '0'>
    in
    [
        Fr(~y),
        Fr(~ekuId),
        !KeyValues(~k),
        !CTValues(~ct),
        Fr(~newSendStreamId),
        Fr(~newRecvStreamId),
        SendStream(~tid, ~sendStreamId, $C, $S, p_auth_status, p_app_keyc),
        RecvStream(~tid, ~recvStreamId, $C, $S, p_auth_status, p_app_keys),
        C4_Extended_Key_Update(~tid, ~ekuIdOld, 'EKU0', $C, $S, '0', opaque, <request>),
        ClientState(
            ~tid,
            'C4',
            $C,
            $S,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            p_es,
            p_hs,
            p_ms,
            p_cats,
            p_sats,
            p_hs_keyc,
            p_hs_keys,
            p_auth_status,
            p_ems,
            p_rms,
            p_cert_req,
            ExtendedKeyUpdateRunning(),
            ~ekuIdOld,
            PostHandshakeAuthenticationNotRunning()
        )[no_precomp]
    ]
    --[
        ExtendedKeyUpdateResponseClient(~tid, $C),
        ExtendedKeyUpdateResponseClientDetails(),
        Instance(~tid, $C, 'client'),
        Encaps(~k, ~ct, opaque),
        SessionKey(~tid, $C, $S, auth_status, <client_application_traffic_key, server_application_traffic_key>),
        EKUDerivate(~tid, main_secret_n_1, server_application_traffice_secret_n_1, client_application_traffic_secret_n_1, exporter_secret_n_1, resumption_main_secret_n_1, server_application_traffic_key, client_application_traffic_key),
        EKUMainSecret(~tid, $C, opaque, p_ms, main_secret_n_1),
        EKUWriteKeyDerivation(~tid, $C, $S, client_application_traffic_key, opaque, ~k),
        WriteKeyDerivation(~tid, $C, $S, client_application_traffic_key, opaque, ~k),
        EKUReadKeyDerivation(~tid, $C, $S, server_application_traffic_key, opaque, ~k),
        ReadKeyDerivation(~tid, $C, $S, server_application_traffic_key, opaque, ~k)
    ]->
    [
        C4_Extended_Key_Update(~tid, ~ekuId, 'EKU1', $C, $S, ~y, server_application_traffic_key, <request, response>),
        MessageOut(senc{response}p_app_keyc),
        SendStream(~tid, ~newSendStreamId, $C, $S, auth_status, client_application_traffic_key),
        RecvStream(~tid, ~newRecvStreamId, $C, $S, auth_status, p_app_keys),
        ClientState(
            ~tid,
            'C4',
            $C,
            $S,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            exporter_secret_n_1,
            p_hs,
            main_secret_n_1,
            client_application_traffic_secret_n_1,
            server_application_traffice_secret_n_1,
            p_hs_keyc,
            p_hs_keys,
            auth_status,
            p_ems,
            resumption_main_secret_n_1,
            p_cert_req,
            ExtendedKeyUpdateRunning(),
            ~ekuId,
            PostHandshakeAuthenticationNotRunning()
        )[no_precomp]
    ]

