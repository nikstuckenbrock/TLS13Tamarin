rule Reveal_Ltk:
  [ !Ltk($A, ~ltkA) ]
  --[ RevLtk($A) ]->
  [ MessageOut(~ltkA) ]

rule reveal_psk:
  [ F_SecretPSK($A,res_psk) ]
  --[ RevealPSK($A, res_psk) ]->
  [ MessageOut(res_psk) ]

/**
 * Reveal of the ephermeral secret key generated by the client.
 */
rule reveal_kem_ephermeral:
  [ !KEMEphermeralKey(~tid, $identity, publicKey, ~privateKey) ]
  --[ RevealKemEphermeral(~tid, $identity, publicKey) ]->
  [ MessageOut(~privateKey) ]
