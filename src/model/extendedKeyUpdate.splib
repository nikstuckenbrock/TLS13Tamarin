rule extended_key_update_request_client:
    let
        gx = p_g^~x
        key_share_entry = KeyShareEntry(p_g, gx)
        request = Handshake(HandshakeMessageTypeExtendedKeyUpdate(), ExtendedKeyUpdateRequest(key_share_entry))
    in
    [
        Fr(~x),
        SendStream(~tid, $C, $S, p_auth_status, applicationTrafficKeyClient),
        ClientState(
            ~tid,
            'C4',
            $C,
            $S,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            p_es,
            p_hs,
            p_ms,
            p_cats,
            p_sats,
            p_hs_keyc,
            p_hs_keys,
            p_auth_status,
            p_ems,
            p_rms,
            p_cert_req,
            ExtendedKeyUpdateNotRunning()
        )
    ]
    --[
        ExtendedKeyUpdateRequestClient(~tid),
        Instance(~tid, $C, 'client')
    ]->
    [
        C4_Extended_Key_Update(~tid, 'EKU0', $C, $S, ~x, gx, '0', <request>),
        MessageOut(senc{request}applicationTrafficKeyClient),
        ClientState(
            ~tid,
            'C4',
            $C,
            $S,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            p_es,
            p_hs,
            p_ms,
            p_cats,
            p_sats,
            p_hs_keyc,
            p_hs_keys,
            p_auth_status,
            p_ems,
            p_rms,
            p_cert_req,
            ExtendedKeyUpdateRunning()
        )
    ]

rule extended_key_update_request_client_receive:
    let
        key_share_entry = KeyShareEntry(p_g, gx)
        request = Handshake(HandshakeMessageTypeExtendedKeyUpdate(), ExtendedKeyUpdateRequest(key_share_entry))
    in
    [
        F_MessageIn(senc{request}p_app_keyc),
        RecvStream(~tid, $S, $C, p_auth_status, p_app_keyc),
        SendStream(~tid, $S, $C, p_auth_status, p_app_keys),
        ServerState(
            ~tid,
            'S4',
            $S,
            $C,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            p_es,
            p_hs,
            p_ms,
            p_cats,
            p_sats,
            p_hs_keyc,
            p_hs_keys,
            p_auth_status,
            p_ems,
            p_rms,
            p_cert_req,
            ExtendedKeyUpdateNotRunning()
        )
    ]
    --[
        ExtendedKeyUpdateRequestClientReceive(~tid),
        Instance(~tid, $S, 'server')
    ]->
    [
        S4_Extended_Key_Update(~tid, 'EKU0', $S, $C, gx, '0', <request>),
        ServerState(
            ~tid,
            'S4',
            $S,
            $C,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            p_es,
            p_hs,
            p_ms,
            p_cats,
            p_sats,
            p_hs_keyc,
            p_hs_keys,
            p_auth_status,
            p_ems,
            p_rms,
            p_cert_req,
            ExtendedKeyUpdateRunning()
        ),
        RecvStream(~tid, $S, $C, p_auth_status, p_app_keyc),
        SendStream(~tid, $S, $C, p_auth_status, p_app_keys),
    ]

rule extended_key_update_response_server:
    let
        gy = p_g^~y
        gxy = gx^~y
        key_share_entry = KeyShareEntry(p_g, gy)
        response = Handshake(HandshakeMessageTypeExtendedKeyUpdate(), ExtendedKeyUpdateResponse(key_share_entry))
        
        transcript_hash_n_1 = h(<request, response>)
        
        derived_secret = Expand(p_ms, <'32', 'TLS13derived', '0'>, '32')
        main_secret_n_1 = Extract(gxy, derived_secret)
        client_application_traffic_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13clientapplicationtrafficsecret', transcript_hash_n_1>, '32')
        server_application_traffice_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13serverapplicationtrafficsecret', transcript_hash_n_1>, '32')
        exporter_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13exportermastersecret', transcript_hash_n_1>, '32')
        resumption_main_secret_n_1 = Expand(main_secret_n_1, <'32', 'TLS13resumptionmastersecret', transcript_hash_n_1>, '32')

        client_application_traffic_key = Expand(client_application_traffic_secret_n_1, <'32', 'TLS13applicationdatakeyexpansion_key', '0'>, '32')
        server_application_traffic_key = Expand(server_application_traffice_secret_n_1, <'32', 'TLS13applicationdatakeyexpansion_key', '0'>, '32')
    in
    [
        Fr(~y),
        SendStream(~tid, $S, $C, p_auth_status, p_app_keys),
        RecvStream(~tid, $S, $C, p_auth_status, p_app_keyc),
        S4_Extended_Key_Update(~tid, 'EKU0', $S, $C, gx, '0', <request>),
        ServerState(
            ~tid,
            'S4',
            $S,
            $C,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            p_es,
            p_hs,
            p_ms,
            p_cats,
            p_sats,
            p_hs_keyc,
            p_hs_keys,
            p_auth_status,
            p_ems,
            p_rms,
            p_cert_req,
            ExtendedKeyUpdateRunning()
        )
    ]
    --[
        ExtendedKeyUpdateResponseServer(~tid),
        Instance(~tid, $S, 'server')
    ]->
    [
        S4_Extended_Key_Update(~tid, 'EKU1', $S, $C, gx, gy, <request, response>),
        MessageOut(senc{response}p_app_keys),
        SendStream(~tid, $S, $C, p_auth_status, server_application_traffic_key),
        RecvStream(~tid, $S, $C, p_auth_status, client_application_traffic_key),
        ServerState(
            ~tid,
            'S4',
            $S,
            $C,
            p_res_psk,
            p_messages,
            p_nc,
            p_ns,
            p_g,
            p_sg,
            p_hrr,
            p_x,
            p_y,
            p_gx,
            p_gy,
            p_gxy,
            p_psk_ke_mode,
            p_psk_id,
            p_edi,
            exporter_secret_n_1,
            p_hs,
            main_secret_n_1,
            client_application_traffic_secret_n_1,
            server_application_traffice_secret_n_1,
            p_hs_keyc,
            p_hs_keys,
            p_auth_status,
            p_ems,
            resumption_main_secret_n_1,
            p_cert_req,
            ExtendedKeyUpdateRunning()
        )
    ]

