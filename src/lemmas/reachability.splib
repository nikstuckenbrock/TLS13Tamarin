tactic: reachability
presort: i
deprio:
    regex "splitEqs"
deprio:
    regex "ServerState\( ~tid, 'S4'.*'1'.*'0'\)"

tactic: reachabilityPsk
presort: i
prio:
    regex "splitEqs"
prio:
    regex "F_MessageIn\( <'1', '0x0303'.*Expand\(Expand"
prio:
    regex "!ServerPSK"

lemma exists_C0 [heuristic={reachability}]: exists-trace
    "Ex tid #i. C0(tid)@i"

lemma exists_S0 [heuristic={reachability}]: exists-trace
    "Ex tid #i. S0(tid)@i"

