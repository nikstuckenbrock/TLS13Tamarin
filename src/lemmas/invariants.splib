tactic: invariants
presort: i
prio:
    regex "last"
prio:
    regex "Instance"
prio:
    regex "ClientState"
prio:
    regex "ServerState"
deprio:
    regex "splitEqs"

lemma tid_invariant [use_induction,reuse,heuristic={invariants}]:
    "All tid actor role #i.
        Instance(tid, actor, role)@i
    ==> (Ex #j. Start(tid, actor, role)@j & (#j < #i))"

lemma one_start_per_tid [reuse,heuristic={invariants}]:
    "All tid actor actor2 role role2 #i #j.
        Start(tid, actor, role)@i &
        Start(tid, actor2, role2)@j
    ==> #i=#j"