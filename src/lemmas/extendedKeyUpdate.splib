#ifdef reachability
/**
* This section contains reachability/executability lemmas to sanity check the protocol execution workflow.
* This group of lemmas is related to an execution initiated by the client.
*/

lemma exists_extended_key_update_request_client [heuristic={reachability}]: exists-trace
    "Ex tid identity #i.
        ExtendedKeyUpdateRequestClient(tid, identity)@i"

lemma exists_extended_key_update_request_client_receive [heuristic={reachability}]: exists-trace
    "Ex tid identity #i.
        ExtendedKeyUpdateRequestClientReceive(tid, identity)@i"

lemma exists_extended_key_update_response_server [heuristic={reachability}]: exists-trace
    "Ex tid #i.
        ExtendedKeyUpdateResponseServer(tid, identity)@i"

lemma exists_extended_key_update_response_server_receive [heuristic={reachability}]: exists-trace
    "Ex tid identity #i.
        ExtendedKeyUpdateResponseServerReceive(tid, identity)@i"

lemma exists_extended_key_update_finish_client [heuristic={reachability}]: exists-trace
    "Ex tid identity #i.
        ExtendedKeyUpdateFinishClient(tid, identity)@i"

lemma exists_extended_key_update_finish_client_receive [heuristic={reachability}]: exists-trace
    "Ex tid identity #i.
        ExtendedKeyUpdateFinishClientReceive(tid, identity)@i"

lemma exists_eku_with_post_handshake_auth [heuristic={reachability}]: exists-trace
    "Ex tid identity #i #j.
        ExtendedKeyUpdateFinishClientReceive(tid, identity)@i &
        S4_cert(tid)@j &
        #i < #j"

#endif

/**
* This section contains desired security properties of the extension.
*/

/**
* For each data send, the adversary doesn't know the data.
*/

/** 
 * To avoid looping, this auxilary lemma should help Tamarin.
 * Every updates requires a session start beforehand.
 */
lemma start_before_eku_request_client [reuse]:
    "All tid identity #t.
        ExtendedKeyUpdateRequestClient(tid, identity)@t
    ==> Ex #x. Start(tid, identity, 'client')@x & #x < #t"

lemma start_before_eku_request_client_receive [reuse]:
    "All tid identity #t.
        ExtendedKeyUpdateRequestClientReceive(tid, identity)@t
    ==> Ex #x. Start(tid, identity, 'server')@x & #x < #t"

lemma start_before_eku_response_server [reuse]:
    "All tid identity #t.
        ExtendedKeyUpdateResponseServer(tid, identity)@t
    ==> Ex #x. Start(tid, identity, 'server')@x & #x < #t"

lemma start_before_eku_response_server_receive [reuse]:
    "All tid identity #t.
        ExtendedKeyUpdateResponseServerReceive(tid, identity)@t
    ==> Ex #x. Start(tid, identity, 'client')@x & #x < #t"

lemma start_before_eku_finish_client [reuse]:
    "All tid identity #t.
        ExtendedKeyUpdateFinishClient(tid, identity)@t
    ==> Ex #x. Start(tid, identity, 'client')@x & #x < #t"

lemma start_before_eku_finish_client_receive [reuse]:
    "All tid identity #t.
        ExtendedKeyUpdateFinishClientReceive(tid, identity)@t
    ==> Ex #x. Start(tid, identity, 'server')@x & #x < #t"

lemma start_before_post_request [reuse]:
    "All tid identity context #t.
        RCertReqCtxt(tid, identity, 'server', context)@t
    ==> Ex #x. Start(tid, identity, 'server')@x & #x < #t"

lemma start_before_post_request_recv [reuse]:
    "All tid identity #t.
        C4_req(tid)@t &
        Instance(tid, identity, 'client')@t
    ==> Ex #x. Start(tid, identity, 'client')@x & #x < #t"

lemma start_before_post_client_auth [reuse]:
    "All tid identity context #t.
        RTranscriptPost(tid, identity, 'client', context)@t
    ==> Ex #x. Start(tid, identity, 'client')@x & #x < #t"

lemma start_before_post_client_auth_recv [reuse]:
    "All tid identity context #t.
        CTranscriptPost(tid, identity, 'server', context)@t
    ==> Ex #x. Start(tid, identity, 'server')@x & #x < #t"

lemma start_before_eku_main_secret [reuse,use_induction,hide_lemma=sig_origin,hide_lemma=posths_rms_weak,hide_lemma=auth_psk,hide_lemma=matching_sessions]:
    "All tid identity role kemPublicKey main_secret_n main_secret_n_1 #t.
        Instance(tid, identity, role)@t &
        EKUMainSecret(tid, identity, kemPublicKey, main_secret_n, main_secret_n_1)@t
    ==> Ex #x. Start(tid, identity, role)@x & #x < #t"

/**
 * Characterizes where the main secret currently held in a client's 'C4' state can come from:
 * either it is the original handshake master secret (RHSMS, set once at the C3->C4 transition),
 * or it is the output of an earlier EKUMainSecret derivation. All other 'C4' rules leave p_ms
 * untouched, so the induction step just carries the invariant through unchanged.
 * This avoids forcing Tamarin to case-split ClientState's raw sources (which range over every
 * post-handshake sub-protocol rule, not just the EKU ones) when resolving eku_key_agreement.
 */
tactic: ekuMsOrigin
presort: i
prio:
    regex "RHSMS"
prio:
    regex "EKUMainSecret"
deprio:
    regex "L_ClientCertReq|L_ServerCertReq|RCertReqCtxt"

lemma eku_ms_state_origin_client [reuse, use_induction, heuristic={ekuMsOrigin}]:
    "All tid actor peer res_psk messages nc ns g sg hrr x y gx gy gxy
        psk_ke_mode psk_id edi es hs ms cats sats hs_keyc hs_keys
        auth_status ems rms cert_req eku_running phs_running #t.
        ClientState(tid, 'C4', actor, peer, res_psk, messages, nc, ns, g, sg,
            hrr, x, y, gx, gy, gxy, psk_ke_mode, psk_id, edi, es, hs, ms,
            cats, sats, hs_keyc, hs_keys, auth_status, ems, rms, cert_req,
            eku_running, phs_running)@t
    ==>
        (Ex #x. RHSMS(tid, actor, 'client', <hs, ms>)@x & (#x < #t | #x = #t))
        |
        (Ex kemPublicKey ms_prev #x.
            EKUMainSecret(tid, actor, kemPublicKey, ms_prev, ms)@x & (#x < #t | #x = #t))"

/**
 * Server-side counterpart of eku_ms_state_origin_client.
 */
lemma eku_ms_state_origin_server [reuse, use_induction, heuristic={ekuMsOrigin}]:
    "All tid actor peer res_psk messages nc ns g sg hrr x y gx gy gxy
        psk_ke_mode psk_id edi es hs ms cats sats hs_keyc hs_keys
        auth_status ems rms cert_req eku_running phs_running #t.
        ServerState(tid, 'S4', actor, peer, res_psk, messages, nc, ns, g, sg,
            hrr, x, y, gx, gy, gxy, psk_ke_mode, psk_id, edi, es, hs, ms,
            cats, sats, hs_keyc, hs_keys, auth_status, ems, rms, cert_req,
            eku_running, phs_running)@t
    ==>
        (Ex #x. RHSMS(tid, actor, 'server', <hs, ms>)@x & (#x < #t | #x = #t))
        |
        (Ex kemPublicKey ms_prev #x.
            EKUMainSecret(tid, actor, kemPublicKey, ms_prev, ms)@x & (#x < #t | #x = #t))"

/**
 * If the starting key is the same, then they must agree on the new updated key.
 * Related key material is not leaked.
 */
tactic: keyAgreement
presort: i
prio:
    regex "Start"
prio:
    regex "RHSMS"
prio:
    regex "EKUMainSecret"
prio:
    regex "C4_Extended_Key_Update"
prio:
    regex "S4_Extended_Key_Update"
prio:
    regex "ClientPSK"
deprio:
    regex "ClientState|ServerState"
deprio:
    regex "client_auth_case|client_auth_cert_case|L_ClientCertReq|L_ServerCertReq|RCertReqCtxt"

lemma eku_key_agreement [reuse,use_induction,heuristic={keyAgreement},hide_lemma=sig_origin,hide_lemma=posths_rms_weak,hide_lemma=auth_psk,hide_lemma=matching_sessions,hide_lemma=posths_rms]:
    "All tid tid2 initiator responder kemPublicKey main_secret_n master_secret_n_1_initiator master_secret_n_1_responder #s #t.
        EKUMainSecret(tid, initiator, kemPublicKey, main_secret_n, master_secret_n_1_initiator)@t &
        EKUMainSecret(tid2, responder, kemPublicKey, main_secret_n, master_secret_n_1_responder)@s
    ==> master_secret_n_1_initiator = master_secret_n_1_responder"
// muss nich vorher schon eine sichere session bestehen?!
