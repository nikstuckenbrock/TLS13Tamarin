/**
 * If the adversary knows a key established using an EKU, the adversary must now the old key and the private KEM part.
 */
lemma eku_main_secret_secrecy [reuse]:
    "All tid actor kemPublicKey main_secret_n main_secret_n_1 #t.
        EKUMainSecret(tid, actor, kemPublicKey, main_secret_n, main_secret_n_1)@t
    ==> (
            ( not Ex #x. KU(main_secret_n_1)@x )
            | (Ex #x. RevealKemEphermeral(tid, actor, kemPublicKey)@x & KU(main_secret_n)@x)
        )"

/**
 * Should be trivial, because all keys depend on the main secret.
 */
lemma eku_derived_secrets_and_keys_secrecy [reuse]:
    "All tid main_secret cats sats es rms catk satk #t.
        EKUDerivate(tid, main_secret, cats, sats, es, rms, catk, satk)@t
    ==> (
            (
                not Ex #x. KU(cats)@x &
                not Ex #x. KU(sats)@x &
                not Ex #x. KU(es)@x &
                not Ex #x. KU(rms)@x &
                not Ex #x. KU(catk)@x &
                not Ex #x. KU(satk)@x
            )
            | Ex #x. KU(main_secret)@x
        )
    "

