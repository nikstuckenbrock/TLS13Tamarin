#ifdef reachability
/**
* This section contains reachability/executability lemmas to sanity check the protocol execution workflow.
* This group of lemmas is related to an execution initiated by the client.
*/

lemma exists_extended_key_update_request_client [heuristic={reachability}]: exists-trace
    "Ex tid #i. ExtendedKeyUpdateRequestClient(tid)@i"

lemma exists_extended_key_update_request_client_receive [heuristic={reachability}]: exists-trace
    "Ex tid #i. ExtendedKeyUpdateRequestClientReceive(tid)@i"

lemma exists_extended_key_update_response_server [heuristic={reachability}]: exists-trace
    "Ex tid #i. ExtendedKeyUpdateResponseServer(tid)@i"

lemma exists_extended_key_update_response_server_receive [heuristic={reachability}]: exists-trace
    "Ex tid #i. ExtendedKeyUpdateResponseServerReceive(tid)@i"

lemma exists_extended_key_update_finish_client [heuristic={reachability}]: exists-trace
    "Ex tid #i. ExtendedKeyUpdateFinishClient(tid)@i"

lemma exists_extended_key_update_finish_client_receive [heuristic={reachability}]: exists-trace
    "Ex tid #i. ExtendedKeyUpdateFinishClientReceive(tid)@i"

/**
* This section contains reachability/executability lemmas to sanity check the protocol execution workflow.
* This group of lemmas is related to an execution initiated by the server.
*/
#endif

/**
* This section contains desired security properties of the extension.
*/

/**
* For each data send, the adversary doesn't know the data.
*/
lemma secrecy_general:
    "All tid actor peer auth data #t.
        ( SendData(tid, actor, peer, auth, data) @ #t )
    ==> ( not Ex #x. K(data) @ #x )"

/**
* Secrecy established after at least one extended key update.
*/
lemma eku_secrecy:
    "All tid actor peer auth data #t.
        // Data was send that is meant to stay secret
        ( SendData(tid, actor, peer, auth, data) @ #t
        // At least one extended key update has happened
        & Ex #i. ExtendedKeyUpdateFinishClientReceive(tid) @ #i )

        // The adversary can't now the message content, otherwise
    ==> ( not ( Ex #x. K(data) @ #x )
        // Handshake information has been leaked
        | ( Ex #x. RevLtk(peer) @ #x )
        | ( Ex z #x. RevDHExp(tid, peer, z) @ #x )
        | ( Ex z #x. RevDHExp(tid, actor, z) @ #x )
        | ( Ex rms #x. RevealPSK(actor, rms) @ #x )
        | ( Ex rms #x. RevealPSK(peer, rms) @ #x ))"

/**
    not (Ex #r. RevLtk(peer)@r & #r < #i) &
    not (Ex tid3 x #r. RevDHExp(tid3, peer, x)@r & #r < #i) &
    not (Ex tid4 y #r. RevDHExp(tid4, actor, y)@r & #r < #i) &
    not (Ex rms #r. RevealPSK(actor, rms)@r & #r < #i) &
    not (Ex rms #r. RevealPSK(peer, rms)@r & #r < #i) &
*/

/**
* For each individual extended key update both parties agree on the same keys,
* if a post handshake authentication was successfull.
*/

/**
* For reach new message after the schedule the adversary does not know the key,
* if the key itself or its components where not revealed.
* Refers to post compromise security.
*/

