lemma exists_extended_key_update_response_client_receive [heuristic={reachability}]: exists-trace
    "Ex tid identity #i.
        ExtendedKeyUpdateResponseClientReceive(tid, identity)@i"

lemma exists_extended_key_update_finish_server [heuristic={reachability}]: exists-trace
    "Ex tid identity #i.
        ExtendedKeyUpdateFinishServer(tid, identity)@i"

lemma exists_extended_key_update_finish_server_receive [heuristic={reachability}]: exists-trace
    "Ex tid identity #i.
        ExtendedKeyUpdateFinishServerReceive(tid, identity)@i"

lemma exists_eku_with_post_handshake_auth [heuristic={reachability}]: exists-trace
    "Ex tid identity #i #j.
        ExtendedKeyUpdateFinishClientReceive(tid, identity)@i &
        S4_cert(tid)@j &
        #i < #j"

