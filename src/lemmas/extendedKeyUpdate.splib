// maybe something like
// the adverasray can only know the previous master secret, if he has one or more of the floowing things
//

/**
* Passive attacker implies both parties agreed on the same keys, requiring a correct protocol model.
* After both parties agreed on a key, the adversary can only know a message sent by the updated key, if he knows all three components:
* - Handshake private part (KEM)
* - Certificate private server
* - EKU private part (KEM)
*/
lemma passive_secrecy [hide_lemma=eku_derived_secrets_and_keys_secrecy,hide_lemma=eku_main_secret_secrecy,hide_lemma=eku_key_agreement,hide_lemma=sig_origin,hide_lemma=posths_rms_weak,hide_lemma=auth_psk,hide_lemma=matching_sessions,hide_lemma=posths_rms,hide_lemma=mutual_entity_authentication,hide_lemma=mutual_transcript_agreement,hide_lemma=injective_mutual_entity_authentication]:
    "All tid tid2 actor peer auth message publicKemKey writeKey role1 role2 sharedKemKey #s #t #u #v.
        SendData(tid, actor, peer, auth, message, writeKey)@s &
        EKUWriteKeyDerivation(tid, actor, peer, writeKey, publicKemKey, sharedKemKey)@t &
        EKUReadKeyDerivation(tid2, peer, actor, writeKey, publicKemKey, sharedKemKey)@u &
        GoodKey(publicKemKey)@v &
        Instance(tid, actor, role1)@t &
        Instance(tid2, peer, role2)@u &
        not (role1 = role2)
    ==> not (Ex #x. K(message)@x) |
        ( Ex #x. RevealKemEphermeral(tid, actor, publicKemKey)@x ) |
        ( Ex #x. RevealKemEphermeral(tid2, peer, publicKemKey)@x )"

/**
lemma injective_mutual_entity_authentication [hide_lemma=eku_derived_secrets_and_keys_secrecy,hide_lemma=eku_main_secret_secrecy,hide_lemma=eku_key_agreement,hide_lemma=sig_origin,hide_lemma=posths_rms_weak,hide_lemma=auth_psk,hide_lemma=matching_sessions,hide_lemma=posths_rms,hide_lemma=mutual_entity_authentication,hide_lemma=mutual_transcript_agreement,hide_lemma=injective_mutual_entity_authentication]:
    "All tid actor peer role hs rms aas messages #i.
        RPostHS(tid, actor, role, <hs, rms, peer, <aas, 'auth'>, messages>)@i
    ==> Ex role2 tid2 #j. RPostHS(tid2, peer, role2, <hs, rms, peer, <'auth', aas>, messages>)@j & #j < #i & not role = role2 &
        (All tid3 peer2 #k. RPostHS(tid3, peer2, role2, <hs, rms, peer, <'auth', aas>, messages>)@k ==> #k = #j)"
*/
lemma injective_mutual_entity_authentication_breaks [hide_lemma=eku_derived_secrets_and_keys_secrecy,hide_lemma=eku_main_secret_secrecy,hide_lemma=eku_key_agreement,hide_lemma=sig_origin,hide_lemma=posths_rms_weak,hide_lemma=auth_psk,hide_lemma=matching_sessions,hide_lemma=posths_rms,hide_lemma=mutual_entity_authentication,hide_lemma=mutual_transcript_agreement,hide_lemma=injective_mutual_entity_authentication]:
    "All tid tid2 actor peer role role2 key hs rms aas messages #i #j.
        RPostHS(tid, actor, role, <hs, rms, peer, <'auth', aas>, messages>)@i &
        RPostHS(tid2, peer, role2, <hs, rms, peer, <aas, 'auth'>, messages>)@j &
        RPostHSKeyDeleteMe(tid2, peer, key)@j &
        #j < #i &
        not role = role2
    ==> not (Ex #x. K(key)@x) |
        ( Ex #x. RevLtk(actor)@x )"

lemma secrecy:
    "All tid actor peer auth message role publicKemKey writeKey sharedKemKey #s #t #u.
        SendData(tid, actor, peer, auth, message, writeKey)@s &
        WriteKeyDerivation(tid, actor, peer, writeKey, publicKemKey, sharedKemKey)@t &
        Instance(tid, actor, role)@t &
        GoodKey(publicKemKey)@u
    ==> not (Ex #x. K(message)@x)
        /**
         * The peers private certificate must stay secret, otherwise attacker can intercept handshake authentication.
         */
        | (Ex #x. RevLtk(peer)@x & #x < #s)
        /**
         * The resumption master secrets must always stay secret, otherwise an attacker could resumpt a session.
         */
        | (Ex rms #x. RevealPSK(actor, rms)@x)
        | (Ex rms #x. RevealPSK(peer, rms)@x)
        /**
         * The private parts of the key schedule related to the write key must stay secret, otherwise the attacker could learn the key.
         */
        | (Ex someTid someActor #x. RevealKemEphermeral(someTid, someActor, publicKemKey)@x )
        
        | (role = 'server' & not (Ex key #x #y. ServerReceivedKey(tid, actor, key)@x & GoodKey(key)@y))
        "

lemma server_message_secrecy:
    "All tid actor peer auth message publicKemKey pas writeKey sharedKemKey #s #t #u #w.
        SendData(tid, actor, peer, auth, message, writeKey)@s &
        WriteKeyDerivation(tid, actor, peer, writeKey, publicKemKey, sharedKemKey)@t &
        Instance(tid, actor, 'server')@t &
        CIdentityPost(tid, actor, 'server', <<peer, <pas, 'auth'>>>)@w
        GoodKey(publicKemKey)@u
    ==> not (Ex #x. K(message)@x)
        | (Ex #x. RevLtk(peer)@x & #x < #s)
        | (Ex rms #x. RevealPSK(actor, rms)@x)
        | (Ex rms #x. RevealPSK(peer, rms)@x)
        | (Ex someTid someActor #x. RevealKemEphermeral(someTid, someActor, publicKemKey)@x )"


lemma handshake_message_secrecy [hide_lemma=eku_derived_secrets_and_keys_secrecy,hide_lemma=eku_main_secret_secrecy,hide_lemma=eku_key_agreement,hide_lemma=sig_origin,hide_lemma=posths_rms_weak,hide_lemma=auth_psk,hide_lemma=matching_sessions,hide_lemma=posths_rms,hide_lemma=mutual_entity_authentication,hide_lemma=mutual_transcript_agreement,hide_lemma=injective_mutual_entity_authentication]:
    "All tid actor peer message writeKey someAuth publicKemKey sharedKemKey #s #t.
        SendData(tid, actor, peer, <someAuth, 'auth'>, message, writeKey)@s &
        HandshakeWriteKeyDerivation(tid, actor, peer, writeKey, publicKemKey, sharedKemKey)@t &
        not ((Ex someTid someIdentity #x. ExtendedKeyUpdateRequestClient(someTid, someIdentity)@x) 
            | (Ex someTid someIdentity #x. ExtendedKeyUpdateRequestServer(someTid, someIdentity)@x))
    ==> not (Ex #x. K(message)@x)
        | (Ex #x. RevLtk(peer)@x & #x < #s)
        | (Ex rms #x. RevealPSK(actor, rms)@x)
        | (Ex rms #x. RevealPSK(peer, rms)@x)
        | (Ex someTid someActor #x. RevealKemEphermeral(someTid, someActor, publicKemKey)@x )"
